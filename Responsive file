* { box-sizing: border-box; }
body { margin: 0; font-family: Arial, sans-serif; color: #182538; background: #f3f6fa; }
.site-header { background: #173b66; color: white; padding: 20px 32px; }
h1 { margin: 0 0 16px; }
nav { display: flex; flex-wrap: wrap; gap: 24px; }
nav a { color: white; text-decoration: none; font-weight: bold; white-space: nowrap; }
main { width: 90%; max-width: 1100px; margin: 30px auto; }
.intro { margin-bottom: 30px; }
.card-container { display: flex; flex-wrap: wrap; gap: 20px; }
.card { flex: 1 1 300px; min-width: 0; max-width: 340px; background: white; border: 1px solid #c8d2df; border-radius: 10px; padding: 16px; }
.card img { display: block; width: 100%; max-width: 100%; height: auto; border-radius: 6px; }
.card h3 { color: #173b66; }
footer { padding: 12px 32px; background: #e1e9f3; }

@media (max-width: 600px) {
  .site-header { padding: 20px; }
  nav { flex-direction: column; align-items: flex-start; gap: 12px; }
  main { width: calc(100% - 32px); }
  .card { flex: 1 1 100%; max-width: 100%; }
  footer { padding: 12px 16px; }
}
